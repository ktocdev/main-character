# Shell scripts run on Linux in CI; CRLF would break the interpreter.
*.sh text eol=lf
# The POSIX front door runs under sh; the Windows one under cmd.exe,
# which misreads labels and gotos in LF-only batch files.
journal text eol=lf
*.cmd text eol=crlf
# Git hooks run under bash, which reads a CR as part of the command.
scripts/hooks/* text eol=lf
