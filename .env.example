# Copy to .env and fill in. Everything here is optional for bulk import —
# the Anthropic key is only needed once the companion / Claude-powered
# metadata extraction comes online.

# ANTHROPIC_API_KEY=sk-ant-...

# Your name — entity extraction uses this to avoid creating an entity for you
# MC_AUTHOR_NAME=

# Override storage locations (defaults: ./journal_entries and ./chroma_data)
# MC_JOURNAL_DIR=
# MC_CHROMA_DIR=

# Override the other data directories (defaults: ./entity_graph, ./summaries,
# ./categories, ./patterns, ./dreams, ./sessions)
# MC_ENTITY_DIR=
# MC_SUMMARY_DIR=
# MC_CATEGORY_DIR=
# MC_PATTERN_DIR=
# MC_DREAM_DIR=
# MC_SESSION_DIR=

# Server (default: 127.0.0.1:8144)
# MC_HOST=
# MC_PORT=

# Two-model split. The companion is the one user-visible voice, so quality
# matters most there — default is Opus. Processing (entity extraction,
# summaries, arcs, categories, patterns, dreams, organic naming, seed
# integration) is structured/mechanical, runs in bulk, and dominates token
# spend — default is Sonnet 5. Both accept the full model lineup: Opus
# 4.6/4.7/4.8, Opus 5, Sonnet 5, Haiku 4.5.
# MC_COMPANION_MODEL=claude-opus-4-6
# MC_PROCESSING_MODEL=claude-sonnet-5

# Companion effort level (low/medium/high/max/xhigh, model-dependent; Haiku
# 4.5 takes none). No processing-side equivalent — thinking is disabled on
# processing calls by default, so an effort setting there wouldn't move
# the bill the way model choice does.
# MC_COMPANION_EFFORT=high

# Spend caps. Runaway detectors, not budgets: both defaults sit above a heavy
# month of ordinary journaling, because a ceiling tuned to normal use fires on
# a good week of writing and a journal that refuses to answer is a worse
# failure than a surprising bill. Blank uses the default; 0 turns one off.
# Checked before each call, so the call that crosses a line finishes and the
# next one is refused. The figures are list-price estimates -- the backstop
# that does not depend on this app being right is a spend limit on your
# Anthropic Console account.
# MC_MAX_SESSION_SPEND=10
# MC_MAX_MONTHLY_SPEND=100
# MC_SPEND_FILE=spend_ledger.json

# The longest text one entry, chat turn or lookup may carry. Past it the
# request is refused, never truncated: an entry silently cut in half is
# writing the author believes was saved.
# MC_MAX_INPUT_CHARS=100000

# Built-in categories to turn off — a comma-separated list of names the tagger
# should stop offering on new entries (e.g. relationships,pets). Blank means
# all on; at least one must stay on. Disabling one never touches entries
# already tagged with it, and the journal still grows its own custom
# categories from what you write. Easier to set in Settings → Journal.
# MC_DISABLED_CATEGORIES=

# Retrieval tuning
# MC_N_SEMANTIC=6
# MC_N_RECENT=3
# MC_EXCERPT_CHARS=2000
# Passage search (passages.py): the size of each search passage in the
# model's tokens, and how many neighbouring passages are shown around a match.
# MC_PASSAGE_TOKENS=254
# MC_PASSAGE_NEIGHBORS=0
# The local model that embeds the passage index, and where it is downloaded
# to (once per machine, about 130 MB). Changing the model means running
# `python rebuild_index.py`; until then search uses the older index.
# MC_EMBED_MODEL=snowflake/snowflake-arctic-embed-s
# MC_MODEL_CACHE=~/.cache/main-character
# MC_MAX_TOKENS=8000

# Looking around without an API key: use the demo journal, not a flag.
#
#   python seed_corpus/import_seed_corpus.py --demo    (one-time, free)
#   then Settings -> load demo journal
#
# The demo runs canned replies from mock_fixtures/ (real captured Claude
# output) against its own data directories, so nothing you type there can
# reach your entries and any restart puts you back. A banner sits above the
# UI the whole time, so canned output is never mistaken for real.
#
# There is deliberately no .env switch for this. MC_MOCK is an internal
# detail of how the demo boots, read from the process environment only: set
# here it is reported and ignored, because canned replies pointed at the
# journal configured below would write real entries against replies Claude
# never sent.
