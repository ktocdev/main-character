# Environment
.env
.env.*
!.env.example
venv/
.venv/
*.key

# Python
__pycache__/
*.pyc

# Data (local-only)
# Anchored to the repo root on purpose. Unanchored, these match at any
# depth and silently swallow seed_corpus/journal_entries/, /summaries/
# and /sessions/ — the corpus that is supposed to ship.
/chroma_data/
/journal_entries/
/entity_graph/
/summaries/
/categories/
/patterns/
/dreams/
/sessions/
# What this journal has spent, by month. Local-only for the same reason the
# entries are: it is a record of one person's use, and it is regenerated by
# living rather than by cloning.
/spend_ledger.json
conversations.json
*.export.json
import_list.txt

# IDE
.vscode/
.idea/

# Local run artifacts
*.log
backups/
# What export.py and backup.py write: the journal itself, in a folder and in
# a zip. Both are the whole corpus in plain text — the single easiest thing
# to commit by accident.
exports/

# All dev docs are local-only — real journal content, third-party names,
# and the security audit throughout; none of it ships (Phase 1.5 items 1/4/5)
docs/

# Later-phase artifacts (pre-emptive — Phase 0.5 item 5)
publish.toml
public_site/
export/

# Leak-detection name list — sensitive in itself, never tracked (Phase 0 item 12)
# Glob, not the bare name: a hand-made .bak copy of the list is just as
# sensitive as the list, and gitignore has no trailing comments.
third-party-names.txt*

# Seed corpus scratch dirs — working state, not deliverables.
# build/ is where the corpus is chatted through the real companion;
# install/ is the throwaway data dir fixtures are captured from.
# The artifacts worth keeping are promoted to seed_corpus/sessions/
# and seed_corpus/summaries/.
seed_corpus/build/
seed_corpus/install/
