{
  "$comment": "The Card component for Figma, read by figma/card/code.js. Every value mirrors static/css/card.css (spec: docs/design_handoff_card/README.md); change both together. Lengths are rem (x remPx). A {rem, token} value is bound to the Figma variable of that token name; a bare number stays a literal because no token has that value. Colors are role names only (the Semantic collection that figma/components syncs); `fallback` is their dark values from static/css/tokens.css, used only when the file has no variable by that name.",
  "name": "Card",
  "remPx": 16,
  "fonts": {
    "serif": "Old Standard TT",
    "ui": "CMU Sans Serif Demi Condensed"
  },
  "colors": {
    "card": "bg-raised",
    "border": "border-default",
    "visual": "bg-muted",
    "glyph": "text-accent",
    "type": "text-accent-muted",
    "title": "text-default",
    "desc": "text-muted",
    "badgeFill": "bg-muted",
    "badgeText": "text-muted"
  },
  "radius": {
    "card": { "px": 10, "token": "radius-lg" },
    "badge": { "px": 999, "token": "radius-pill" }
  },
  "fallback": {
    "bg-raised": "#2a2521",
    "bg-muted": "#322c27",
    "border-default": "#3d362f",
    "text-default": "#e8e0d5",
    "text-muted": "#a99f92",
    "text-accent": "#d99e5b",
    "text-accent-muted": "#8a6a44"
  },
  "sample": {
    "type": "summary",
    "glyph": "¶",
    "title": "Week of September 22",
    "description": "Two late nights writing, a run with Mika at Greenwood Park, and the first week the recovery didn’t cost a sick day.",
    "badges": ["Sep 22–28", "7 entries", "family", "work"],
    "shownBadges": 2,
    "more": "+2"
  },
  "text": {
    "typeLineHeight": 130,
    "typeLetterSpacing": 10,
    "titleLineHeight": 125,
    "badgeLineHeight": 140
  },
